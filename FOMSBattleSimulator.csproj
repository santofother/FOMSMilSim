<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>FOMS</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Optimise even Debug builds so perf numbers are representative -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- WHY: the sim and its tests are separate projects; keep their sources out of the Godot assembly. -->
  <ItemGroup>
    <Compile Remove="src/Sim/**" />
    <Compile Remove="tests/**" />
    <None Remove="src/Sim/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Sim/FOMS.Sim.csproj" />
  </ItemGroup>
</Project>
